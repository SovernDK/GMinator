        "basic",
        "special",
        "class"
      ],
      "title": "Category",
      "type": "string"
    },
    "trigger": {
      "title": "Trigger",
      "type": "string"
    },
    "target": {
      "default": false,
      "description": "Whether the move is made against a target",
      "title": "Target",
      "type": "boolean"
    },
    "roll": {
      "anyOf": [
        {
          "description": "An expression, e.g. `stat.str` or `d6 + 1`",
          "type": [
            "string",
            "integer"
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The modifier added to the pack's roll, e.g. `stat.str`",
      "title": "Roll"
    },
    "stat_options": {
      "anyOf": [
        {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stats the player picks from; the roll refers to `stat.chosen`",
      "title": "Stat Options"
