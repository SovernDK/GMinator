{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AddForward": {
      "additionalProperties": false,
      "properties": {
        "add_forward": {
          "$ref": "#/$defs/ForwardArgs"
        }
      },
      "required": [
        "add_forward"
      ],
      "title": "AddForward",
      "type": "object"
    },
    "AddTag": {
      "additionalProperties": false,
      "properties": {
        "add_tag": {
          "$ref": "#/$defs/TagArgs"
        }
      },
      "required": [
        "add_tag"
      ],
      "title": "AddTag",
      "type": "object"
    },
    "AdvanceClock": {
      "additionalProperties": false,
      "properties": {
        "advance_clock": {
          "$ref": "#/$defs/ClockArgs"
        }
      },
      "required": [
        "advance_clock"
      ],
      "title": "AdvanceClock",
      "type": "object"
    },
    "AskArgs": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "integer"
        },
        "questions": {
          "items": {
            "type": "string"
          },
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "n",
        "questions"
      ],
      "title": "AskArgs",
      "type": "object"
    },
    "AskQuestions": {
      "additionalProperties": false,
      "properties": {
        "ask_questions": {
          "$ref": "#/$defs/AskArgs"
        }
      },
      "required": [
        "ask_questions"
      ],
      "title": "AskQuestions",
      "type": "object"
    },
    "Bands": {
      "additionalProperties": false,
      "properties": {
        "strong": {
          "default": 10,
          "title": "Strong",
          "type": "integer"
        },
        "partial": {
          "default": 7,
          "title": "Partial",
          "type": "integer"
        }
      },
      "title": "Bands",
      "type": "object"
    },
    "ChooseArgs": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "exclusiveMinimum": 0,
          "title": "N",
          "type": "integer"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/Option"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "n",
        "options"
      ],
      "title": "ChooseArgs",
      "type": "object"
    },
    "ChooseN": {
      "additionalProperties": false,
      "properties": {
        "choose_n": {
          "$ref": "#/$defs/ChooseArgs"
        }
      },
      "required": [
        "choose_n"
      ],
      "title": "ChooseN",
      "type": "object"
    },
    "ClearObstacle": {
      "additionalProperties": false,
      "properties": {
        "clear_obstacle": {
          "const": "target",
          "description": "Clears the obstacle the move is made against (target: obstacle)",
          "title": "Clear Obstacle",
          "type": "string"
        }
      },
      "required": [
        "clear_obstacle"
      ],
      "title": "ClearObstacle",
      "type": "object"
    },
    "ClockArgs": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Clock",
          "type": "string"
        },
        "amount": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "clock"
      ],
      "title": "ClockArgs",
      "type": "object"
    },
    "DamageArgs": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "An expression, e.g. `stat.str` or `d6 + 1`",
          "title": "Amount",
          "type": [
            "string",
            "integer"
          ]
        },
        "target": {
          "default": "target",
          "enum": [
            "self",
            "target"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "DamageArgs",
      "type": "object"
    },
    "DangerGate": {
      "additionalProperties": false,
      "description": "Acting near a hostile NPC means acting despite danger: the engine makes this move\nfirst, and a miss stops the action.",
      "properties": {
        "move": {
          "description": "The move made first, e.g. defy_danger; it needs stat_options",
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Move",
          "type": "string"
        },
        "default_stat": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Default Stat",
          "type": "string"
        },
        "stat_by_flag": {
          "default": {},
          "description": "The stat rolled for an action with this flag, if not the default",
          "patternProperties": {
            "^[a-z][a-z0-9_]*$": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            }
          },
          "title": "Stat By Flag",
          "type": "object"
        },
        "exempt": {
          "default": [],
          "description": "Flags of actions that are never gated",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Exempt",
          "type": "array"
        }
      },
      "required": [
        "move",
        "default_stat"
      ],
      "title": "DangerGate",
      "type": "object"
    },
    "DealDamage": {
      "additionalProperties": false,
      "properties": {
        "deal_damage": {
          "$ref": "#/$defs/DamageArgs"
        }
      },
      "required": [
        "deal_damage"
      ],
      "title": "DealDamage",
      "type": "object"
    },
    "ForwardArgs": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "title": "Amount",
          "type": "integer"
        },
        "target": {
          "default": "self",
          "enum": [
            "self",
            "target"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "ForwardArgs",
      "type": "object"
    },
    "GainHold": {
      "additionalProperties": false,
      "properties": {
        "gain_hold": {
          "$ref": "#/$defs/GainHoldArgs"
        }
      },
      "required": [
        "gain_hold"
      ],
      "title": "GainHold",
      "type": "object"
    },
    "GainHoldArgs": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "amount"
      ],
      "title": "GainHoldArgs",
      "type": "object"
    },
    "GmMove": {
      "additionalProperties": false,
      "properties": {
        "gm_move": {
          "enum": [
            "soft",
            "hard"
          ],
          "title": "Gm Move",
          "type": "string"
        }
      },
      "required": [
        "gm_move"
      ],
      "title": "GmMove",
      "type": "object"
    },
    "Heal": {
      "additionalProperties": false,
      "properties": {
        "heal": {
          "$ref": "#/$defs/HealArgs"
        }
      },
      "required": [
        "heal"
      ],
      "title": "Heal",
      "type": "object"
    },
    "HealArgs": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "An expression, e.g. `stat.str` or `d6 + 1`",
          "title": "Amount",
          "type": [
            "string",
            "integer"
          ]
        },
        "target": {
          "default": "self",
          "enum": [
            "self",
            "target"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "amount"
      ],
      "title": "HealArgs",
      "type": "object"
    },
    "MarkXp": {
      "additionalProperties": false,
      "properties": {
        "mark_xp": {
          "exclusiveMinimum": 0,
          "title": "Mark Xp",
          "type": "integer"
        }
      },
      "required": [
        "mark_xp"
      ],
      "title": "MarkXp",
      "type": "object"
    },
    "ModifierStep": {
      "additionalProperties": false,
      "properties": {
        "up_to": {
          "title": "Up To",
          "type": "integer"
        },
        "modifier": {
          "title": "Modifier",
          "type": "integer"
        }
      },
      "required": [
        "up_to",
        "modifier"
      ],
      "title": "ModifierStep",
      "type": "object"
    },
    "MoveTo": {
      "additionalProperties": false,
      "properties": {
        "move_to": {
          "$ref": "#/$defs/MoveToArgs"
        }
      },
      "required": [
        "move_to"
      ],
      "title": "MoveTo",
      "type": "object"
    },
    "MoveToArgs": {
      "additionalProperties": false,
      "properties": {
        "location": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Location",
          "type": "string"
        },
        "target": {
          "default": "self",
          "enum": [
            "self",
            "target"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "location"
      ],
      "title": "MoveToArgs",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "effects": {
          "default": [],
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/DealDamage"
              },
              {
                "$ref": "#/$defs/TakeDamage"
              },
              {
                "$ref": "#/$defs/Heal"
              },
              {
                "$ref": "#/$defs/ChooseN"
              },
              {
                "$ref": "#/$defs/AskQuestions"
              },
              {
                "$ref": "#/$defs/GainHold"
              },
              {
                "$ref": "#/$defs/SpendHold"
              },
              {
                "$ref": "#/$defs/AddTag"
              },
              {
                "$ref": "#/$defs/RemoveTag"
              },
              {
                "$ref": "#/$defs/AdvanceClock"
              },
              {
                "$ref": "#/$defs/GmMove"
              },
              {
                "$ref": "#/$defs/MarkXp"
              },
              {
                "$ref": "#/$defs/AddForward"
              },
              {
                "$ref": "#/$defs/UseItem"
              },
              {
                "$ref": "#/$defs/RevealSecret"
              },
              {
                "$ref": "#/$defs/MoveTo"
              },
              {
                "$ref": "#/$defs/ClearObstacle"
              }
            ]
          },
          "title": "Effects",
          "type": "array"
        }
      },
      "required": [
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "RemoveTag": {
      "additionalProperties": false,
      "properties": {
        "remove_tag": {
          "$ref": "#/$defs/TagArgs"
        }
      },
      "required": [
        "remove_tag"
      ],
      "title": "RemoveTag",
      "type": "object"
    },
    "RevealSecret": {
      "additionalProperties": false,
      "properties": {
        "reveal_secret": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Reveal Secret",
          "type": "string"
        }
      },
      "required": [
        "reveal_secret"
      ],
      "title": "RevealSecret",
      "type": "object"
    },
    "SpendHold": {
      "additionalProperties": false,
      "properties": {
        "spend_hold": {
          "$ref": "#/$defs/SpendHoldArgs"
        }
      },
      "required": [
        "spend_hold"
      ],
      "title": "SpendHold",
      "type": "object"
    },
    "SpendHoldArgs": {
      "additionalProperties": false,
      "properties": {
        "move": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Move",
          "type": "string"
        },
        "amount": {
          "default": 1,
          "exclusiveMinimum": 0,
          "title": "Amount",
          "type": "integer"
        }
      },
      "required": [
        "move"
      ],
      "title": "SpendHoldArgs",
      "type": "object"
    },
    "TagArgs": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Tag",
          "type": "string"
        },
        "target": {
          "default": "self",
          "enum": [
            "self",
            "target"
          ],
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "title": "TagArgs",
      "type": "object"
    },
    "TakeDamage": {
      "additionalProperties": false,
      "properties": {
        "take_damage": {
          "$ref": "#/$defs/TakeDamageArgs"
        }
      },
      "required": [
        "take_damage"
      ],
      "title": "TakeDamage",
      "type": "object"
    },
    "TakeDamageArgs": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "description": "An expression, e.g. `stat.str` or `d6 + 1`",
          "title": "Amount",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "amount"
      ],
      "title": "TakeDamageArgs",
      "type": "object"
    },
    "UseItem": {
      "additionalProperties": false,
      "properties": {
        "use_item": {
          "$ref": "#/$defs/UseItemArgs"
        }
      },
      "required": [
        "use_item"
      ],
      "title": "UseItem",
      "type": "object"
    },
    "UseItemArgs": {
      "additionalProperties": false,
      "properties": {
        "tag": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Tag",
          "type": "string"
        }
      },
      "required": [
        "tag"
      ],
      "title": "UseItemArgs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "pattern": "^[a-z][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "license": {
      "title": "License",
      "type": "string"
    },
    "attribution": {
      "title": "Attribution",
      "type": "string"
    },
    "stats": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Stats",
      "type": "array"
    },
    "roll": {
      "default": "2d6",
      "description": "An expression, e.g. `stat.str` or `d6 + 1`",
      "title": "Roll",
      "type": [
        "string",
        "integer"
      ]
    },
    "bands": {
      "$ref": "#/$defs/Bands",
      "default": {
        "strong": 10,
        "partial": 7
      }
    },
    "modifiers": {
      "description": "Score to modifier table, ascending by `up_to`",
      "items": {
        "$ref": "#/$defs/ModifierStep"
      },
      "minItems": 1,
      "title": "Modifiers",
      "type": "array"
    },
    "score_array": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The scores a new character assigns, one per stat",
      "title": "Score Array"
    },
    "miss_effects": {
      "default": [],
      "description": "Applied on every rolled miss",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/DealDamage"
          },
          {
            "$ref": "#/$defs/TakeDamage"
          },
          {
            "$ref": "#/$defs/Heal"
          },
          {
            "$ref": "#/$defs/ChooseN"
          },
          {
            "$ref": "#/$defs/AskQuestions"
          },
          {
            "$ref": "#/$defs/GainHold"
          },
          {
            "$ref": "#/$defs/SpendHold"
          },
          {
            "$ref": "#/$defs/AddTag"
          },
          {
            "$ref": "#/$defs/RemoveTag"
          },
          {
            "$ref": "#/$defs/AdvanceClock"
          },
          {
            "$ref": "#/$defs/GmMove"
          },
          {
            "$ref": "#/$defs/MarkXp"
          },
          {
            "$ref": "#/$defs/AddForward"
          },
          {
            "$ref": "#/$defs/UseItem"
          },
          {
            "$ref": "#/$defs/RevealSecret"
          },
          {
            "$ref": "#/$defs/MoveTo"
          },
          {
            "$ref": "#/$defs/ClearObstacle"
          }
        ]
      },
      "title": "Miss Effects",
      "type": "array"
    },
    "dying_move": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The move a player character makes on reaching 0 HP",
      "title": "Dying Move"
    },
    "danger": {
      "anyOf": [
        {
          "$ref": "#/$defs/DangerGate"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What acting near a hostile NPC takes; without it, nothing"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "license",
    "attribution",
    "stats",
    "modifiers"
  ],
  "title": "GMinator pack manifest (pack.yaml)",
  "type": "object"
}
