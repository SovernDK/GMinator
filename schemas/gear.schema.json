{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Item": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "weight": {
          "default": 0,
          "minimum": 0,
          "title": "Weight",
          "type": "integer"
        },
        "armor": {
          "default": 0,
          "minimum": 0,
          "title": "Armor",
          "type": "integer"
        },
        "uses": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uses"
        },
        "tags": {
          "default": [],
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Item"
  },
  "type": "array",
  "title": "GMinator pack gear (gear.yaml)"
}
