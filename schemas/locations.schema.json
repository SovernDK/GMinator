{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "exits": {
          "default": [],
          "description": "Locations reachable from here",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Exits",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Location",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Location"
  },
  "type": "array",
  "title": "GMinator scenario locations (locations.yaml)"
}
