{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "exits": {
          "default": [],
          "description": "Locations reachable from here",
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Exits",
          "type": "array"
        },
        "obstacles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Obstacle"
          },
          "title": "Obstacles",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Location",
      "type": "object"
    },
    "Obstacle": {
      "additionalProperties": false,
      "description": "Something in the way, until a move made against it clears it.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "blocks": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The exit that can't be used until the obstacle is cleared",
          "title": "Blocks"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Obstacle",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Location"
  },
  "type": "array",
  "title": "GMinator scenario locations (locations.yaml)"
}
