{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Secret": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Secret",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Secret"
  },
  "type": "array",
  "title": "GMinator scenario secrets (secrets.yaml)"
}
